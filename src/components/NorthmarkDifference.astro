---
import { pillars } from '../data/site';
---

<section id="fellowship" class="relative bg-ink py-24 lg:py-32 overflow-hidden" aria-labelledby="difference-heading">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20 reveal-item">
      <h2 id="difference-heading" class="heading-display text-[clamp(2rem,4vw,3.25rem)] text-paper mb-6">
        The Northmark Difference
      </h2>
      <p class="font-body text-paper/70 text-base leading-relaxed">
        Northmark pairs a multi-stage fund with a six-month industry immersion program — built to
        foster innovation, partnership and growth between our network of corporate partners and the
        founders redefining their industries.
      </p>
    </div>

    <div class="relative flex flex-col lg:flex-row items-center justify-center gap-12 lg:gap-8">
      <!-- Left pillar -->
      <div class="pillar-item order-2 lg:order-1 lg:w-64 opacity-0 lg:text-right">
        <div class="flex lg:flex-row-reverse items-start gap-4">
          <i class={pillars[0].icon} class="text-aqua text-lg mt-1 shrink-0" aria-hidden="true"></i>
          <div>
            <h3 class="font-display text-xl font-semibold text-paper mb-2">{pillars[0].title}</h3>
            <p class="font-body text-sm text-paper/65 leading-relaxed mb-4">{pillars[0].description}</p>
            <a href={pillars[0].href} class="explore-link">{pillars[0].link}</a>
          </div>
        </div>
      </div>

      <!-- Triangle SVG -->
      <div class="order-1 lg:order-2 shrink-0 w-full max-w-sm lg:max-w-md px-4" id="triangle-wrap">
        <svg
          viewBox="0 0 320 280"
          class="w-full h-auto"
          role="img"
          aria-label="Diagram connecting Northmark Fund, Fellowship and Network"
        >
          <defs>
            <filter id="vertex-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="4" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>
          <polygon
            id="triangle-shape"
            class="triangle-path"
            points="160,30 30,250 290,250"
            fill="none"
            stroke="#22e0b7"
            stroke-width="1"
            stroke-dasharray="800"
            stroke-dashoffset="800"
          />
          <circle cx="160" cy="30" r="5" fill="#22e0b7" filter="url(#vertex-glow)" class="vertex-glow opacity-0" />
          <circle cx="30" cy="250" r="5" fill="#22e0b7" filter="url(#vertex-glow)" class="vertex-glow opacity-0" />
          <circle cx="290" cy="250" r="5" fill="#22e0b7" filter="url(#vertex-glow)" class="vertex-glow opacity-0" />
          <text x="160" y="18" text-anchor="middle" class="fill-paper font-body text-[8px] tracking-widest" style="font-size:8px;letter-spacing:0.15em;">NORTHMARK FUND</text>
          <text x="30" y="272" text-anchor="middle" class="fill-paper font-body" style="font-size:7px;letter-spacing:0.12em;">NORTHMARK FELLOWSHIP</text>
          <text x="290" y="272" text-anchor="middle" class="fill-paper font-body" style="font-size:7px;letter-spacing:0.12em;">NORTHMARK NETWORK</text>
        </svg>
      </div>

      <!-- Right pillars stacked on mobile -->
      <div class="order-3 lg:hidden w-full space-y-10">
        {
          pillars.slice(1).map((pillar) => (
            <div class="pillar-item opacity-0">
              <div class="flex items-start gap-4">
                <i class={pillar.icon} class="text-aqua text-lg mt-1 shrink-0" aria-hidden="true"></i>
                <div>
                  <h3 class="font-display text-xl font-semibold text-paper mb-2">{pillar.title}</h3>
                  <p class="font-body text-sm text-paper/65 leading-relaxed mb-4">{pillar.description}</p>
                  <a href={pillar.href} class="explore-link">{pillar.link}</a>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Desktop right pillars -->
      <div class="hidden lg:flex lg:flex-col lg:order-3 lg:w-64 gap-16">
        {
          pillars.slice(1).map((pillar) => (
            <div class="pillar-item opacity-0">
              <div class="flex items-start gap-4">
                <i class={pillar.icon} class="text-aqua text-lg mt-1 shrink-0" aria-hidden="true"></i>
                <div>
                  <h3 class="font-display text-xl font-semibold text-paper mb-2">{pillar.title}</h3>
                  <p class="font-body text-sm text-paper/65 leading-relaxed mb-4">{pillar.description}</p>
                  <a href={pillar.href} class="explore-link">{pillar.link}</a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 1023px) {
    #triangle-wrap {
      max-width: 240px;
    }
  }
</style>
