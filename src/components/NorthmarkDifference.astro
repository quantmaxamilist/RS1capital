---
import { pillars } from '../data/site';
import PillarIcon from './PillarIcon.astro';
---

<section id="approach" class="relative bg-black py-24 lg:py-32 overflow-hidden" aria-labelledby="approach-heading" data-glow-follow>
  <div class="approach-glow" aria-hidden="true">
    <div class="approach-glow__spot"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-10 relative z-[1]">
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20" data-reveal>
      <h2 id="approach-heading" class="heading-display text-[clamp(2rem,4vw,3.25rem)] text-mist mb-6">
        The RS1 Approach
      </h2>
      <p class="font-body text-mist/70 text-base leading-relaxed">
        We combine capital, operational capability and advisory expertise to act quickly and
        decisively — regardless of a business's financial status.
      </p>
    </div>

    <div
      class="relative flex flex-col lg:flex-row items-center justify-center gap-12 lg:gap-8"
      data-reveal-group
      data-reveal-stagger="0.1"
    >
      <!-- Left pillar (Capital) -->
      <div class="pillar-item order-2 lg:order-1 lg:w-64 lg:text-right" data-reveal>
        <div class="flex lg:flex-row-reverse items-start gap-4">
          <PillarIcon id={pillars[0].id} />
          <div>
            <h3 class="font-display text-xl font-semibold text-mist mb-2">{pillars[0].title}</h3>
            <p class="font-body text-sm text-mist/65 leading-relaxed mb-4">{pillars[0].description}</p>
            <a href={pillars[0].href} class="explore-link">{pillars[0].link}</a>
          </div>
        </div>
      </div>

      <!-- Triangle SVG -->
      <div class="order-1 lg:order-2 shrink-0 w-full max-w-sm lg:max-w-md px-4" id="triangle-wrap" data-reveal>
        <svg
          viewBox="0 0 320 280"
          class="w-full h-auto"
          role="img"
          aria-label="Diagram connecting Capital, Turnaround and Advisory"
        >
          <defs>
            <clipPath id="triangle-clip">
              <polygon points="160,30 30,250 290,250" />
            </clipPath>
            <radialGradient id="vertex-fill-top" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="rgba(201, 162, 39, 0.42)" />
              <stop offset="55%" stop-color="rgba(201, 162, 39, 0.12)" />
              <stop offset="100%" stop-color="rgba(201, 162, 39, 0)" />
            </radialGradient>
            <radialGradient id="vertex-fill-left" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="rgba(201, 162, 39, 0.38)" />
              <stop offset="55%" stop-color="rgba(201, 162, 39, 0.1)" />
              <stop offset="100%" stop-color="rgba(201, 162, 39, 0)" />
            </radialGradient>
            <radialGradient id="vertex-fill-right" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="rgba(201, 162, 39, 0.38)" />
              <stop offset="55%" stop-color="rgba(201, 162, 39, 0.1)" />
              <stop offset="100%" stop-color="rgba(201, 162, 39, 0)" />
            </radialGradient>
            <filter id="triangle-highlight-glow" x="-30%" y="-30%" width="160%" height="160%">
              <feGaussianBlur stdDeviation="2.5" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
            <filter id="vertex-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="4" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>

          <ellipse
            class="triangle-arc"
            cx="160"
            cy="140"
            rx="120"
            ry="90"
            fill="none"
            stroke="rgba(201, 162, 39, 0.07)"
            stroke-width="1"
          />
          <ellipse
            class="triangle-arc triangle-arc--alt"
            cx="160"
            cy="150"
            rx="90"
            ry="70"
            fill="none"
            stroke="rgba(230, 196, 88, 0.05)"
            stroke-width="1"
          />

          <g clip-path="url(#triangle-clip)">
            <polygon points="160,30 30,250 290,250" fill="rgba(201, 162, 39, 0.025)" />

            <circle
              cx="30"
              cy="250"
              r="220"
              fill="none"
              stroke="rgba(201, 162, 39, 0.4)"
              stroke-width="1"
            />
            <circle
              cx="290"
              cy="250"
              r="220"
              fill="none"
              stroke="rgba(201, 162, 39, 0.4)"
              stroke-width="1"
            />
            <circle
              cx="160"
              cy="30"
              r="220"
              fill="none"
              stroke="rgba(201, 162, 39, 0.4)"
              stroke-width="1"
            />

            <circle cx="160" cy="30" r="44" fill="url(#vertex-fill-top)" class="vertex-radial" />
            <circle cx="30" cy="250" r="40" fill="url(#vertex-fill-left)" class="vertex-radial" />
            <circle cx="290" cy="250" r="40" fill="url(#vertex-fill-right)" class="vertex-radial" />
          </g>

          <polygon
            id="triangle-shape"
            class="triangle-path"
            points="160,30 30,250 290,250"
            fill="none"
            stroke="#c9a227"
            stroke-width="1"
            stroke-dasharray="800"
            stroke-dashoffset="0"
          />
          <polygon
            id="triangle-highlight"
            class="triangle-highlight"
            points="160,30 30,250 290,250"
            fill="none"
            stroke="#e6c458"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-dasharray="52 748"
            stroke-dashoffset="0"
            filter="url(#triangle-highlight-glow)"
            opacity="0"
          />
          <circle cx="160" cy="30" r="5" fill="#c9a227" filter="url(#vertex-glow)" class="vertex-glow" />
          <circle cx="30" cy="250" r="5" fill="#c9a227" filter="url(#vertex-glow)" class="vertex-glow" />
          <circle cx="290" cy="250" r="5" fill="#c9a227" filter="url(#vertex-glow)" class="vertex-glow" />
          <text x="160" y="18" text-anchor="middle" fill="#f0ece0" class="font-body" style="font-size:8px;letter-spacing:0.15em;">CAPITAL</text>
          <text x="30" y="272" text-anchor="middle" fill="#f0ece0" class="font-body" style="font-size:7px;letter-spacing:0.12em;">TURNAROUND</text>
          <text x="290" y="272" text-anchor="middle" fill="#f0ece0" class="font-body" style="font-size:7px;letter-spacing:0.12em;">ADVISORY</text>
        </svg>
      </div>

      <!-- Turnaround + Advisory (single block, all breakpoints) -->
      <div class="order-3 lg:order-3 w-full lg:w-64 flex flex-col gap-10 lg:gap-16">
        {
          pillars.slice(1).map((pillar) => (
            <div class="pillar-item" data-reveal>
              <div class="flex items-start gap-4">
                <PillarIcon id={pillar.id} />
                <div>
                  <h3 class="font-display text-xl font-semibold text-mist mb-2">{pillar.title}</h3>
                  <p class="font-body text-sm text-mist/65 leading-relaxed mb-4">{pillar.description}</p>
                  <a href={pillar.href} class="explore-link">{pillar.link}</a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 1023px) {
    #triangle-wrap {
      max-width: 240px;
    }
  }

  .vertex-glow {
    opacity: 0.6;
  }

  .vertex-radial {
    opacity: 0.55;
  }

  .triangle-highlight {
    pointer-events: none;
  }
</style>
