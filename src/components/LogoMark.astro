---
interface Props {
  compact?: boolean;
  showPhone?: boolean;
}

const { compact = false, showPhone = false } = Astro.props;
---

<div aria-label="J.L. Hughes Carpentry" style="display:inline-flex;flex-direction:column;">
  <div style={`background:#02184a;display:inline-flex;flex-direction:column;${compact ? 'padding:6px 10px;' : 'padding:8px 12px;'}`}>
    <span
      style={`font-family:'Bebas Neue',sans-serif;font-weight:700;font-style:italic;text-transform:uppercase;color:#ffffff;line-height:1;letter-spacing:0.02em;${compact ? 'font-size:11px;' : 'font-size:13px;'}`}
    >
      J.L.HUGHES CARPENTRY
    </span>
    <span
      style="display:block;margin-top:4px;height:3px;width:100%;background:linear-gradient(to right,#f70200 52%,#ffffff 52%);"
      aria-hidden="true"
    ></span>
    {
      showPhone && (
        <span style="margin-top:4px;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.08em;color:rgba(255,255,255,0.9);">
          07495 471877
        </span>
      )
    }
  </div>
</div>
