---
import { stats } from '../data/site';
---

<section
  id="insights"
  class="relative bg-sky py-24 lg:py-32 overflow-hidden"
  aria-labelledby="stats-heading"
>
  <div class="absolute top-0 left-0 w-24 h-24 hatch-corner opacity-40 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-0 right-0 w-24 h-24 hatch-corner opacity-40 pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-10 relative">
    <h2
      id="stats-heading"
      class="heading-display text-[clamp(2rem,4vw,3rem)] text-navy mb-16 reveal-item"
    >
      Strength in Numbers
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-12">
      {
        stats.map((stat) => (
          <div class="stat-item reveal-item" data-stat={JSON.stringify(stat)}>
            <p class="font-body font-normal text-[clamp(2.5rem,5vw,3.5rem)] text-navy leading-none mb-3 stat-number">
              <span class="stat-prefix">{stat.prefix ?? ''}</span>
              <span class="stat-value">0</span>
              <span class="stat-suffix">{stat.suffix ?? ''}</span>
            </p>
            <p class="font-body text-sm font-medium text-navy/70 tracking-wide">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
