---
interface Props {
  class?: string;
  light?: boolean;
}

const { class: className = '', light = false } = Astro.props;
const textColor = light ? 'text-paper' : 'text-paper';
---

<a href="/" class:list={['inline-flex flex-col items-center group', className]} aria-label="Northmark Ventures home">
  <span class:list={['font-display font-semibold tracking-[0.35em] text-xs leading-tight', textColor]}>
    NORTHMARK
  </span>
  <span class:list={['font-display font-semibold tracking-[0.35em] text-[0.625rem] leading-tight mt-0.5', textColor]}>
    VENTURES
  </span>
  <svg
    class="mt-1.5 w-16 h-3 overflow-visible"
    viewBox="0 0 64 12"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M 4 10 Q 32 0 60 10"
      stroke="#22e0b7"
      stroke-width="0.75"
      fill="none"
    />
  </svg>
</a>
