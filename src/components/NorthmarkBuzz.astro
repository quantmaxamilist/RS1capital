---
import { buzzItems } from '../data/site';
---

<section
  id="team"
  class="relative bg-navy py-24 lg:py-32 overflow-hidden"
  aria-labelledby="buzz-heading"
>
  <div class="absolute bottom-0 left-0 right-0 h-1/2 glow-aqua pointer-events-none opacity-60" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-10 relative">
    <div class="flex items-start justify-between gap-6 mb-12">
      <h2 id="buzz-heading" class="heading-display text-[clamp(2rem,4vw,3rem)] text-paper">
        Northmark Buzz
      </h2>
      <a href="#team" class="view-all-pill border-paper/30 text-paper hover:bg-paper hover:text-navy shrink-0">
        VIEW ALL
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {
        buzzItems.map((item) => (
          <article class="buzz-card bg-white rounded-lg overflow-hidden opacity-0">
            <div class="h-48 flex items-center justify-center bg-white">
              <span class="font-display text-3xl font-semibold text-navy/20 tracking-wide">{item.company}</span>
            </div>
            <div class="bg-paper p-6">
              <p class="eyebrow text-navy/60 text-[0.625rem] mb-3">{item.category}</p>
              <h3 class="font-body font-semibold text-navy text-base leading-snug">{item.headline}</h3>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
