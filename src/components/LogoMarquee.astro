---
import { marqueeLogos } from '../data/site';

const doubled = [...marqueeLogos, ...marqueeLogos];
---

<section class="bg-navy py-10 overflow-hidden border-y border-white/5" aria-label="Portfolio company logos">
  <div class="marquee-track flex w-max gap-16 px-8">
    {
      doubled.map((logo, i) => (
        <span
          class="font-display text-2xl md:text-3xl font-semibold text-aqua/40 whitespace-nowrap tracking-wide"
          aria-hidden={i >= marqueeLogos.length}
        >
          {logo}
        </span>
      ))
    }
  </div>
</section>
