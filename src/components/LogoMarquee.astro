---
import { marqueeKeywords } from '../data/site';

const doubled = [...marqueeKeywords, ...marqueeKeywords];
---

<section class="bg-panel py-10 overflow-hidden border-y border-white/5" aria-label="Core capabilities">
  <div class="marquee-track flex w-max px-8 items-center">
    {
      doubled.map((keyword, i) => (
        <span
          class="font-body text-sm md:text-base font-medium text-gold/50 whitespace-nowrap tracking-wide uppercase inline-flex items-center"
          aria-hidden={i >= marqueeKeywords.length}
        >
          {keyword}
          <span class="mx-8 text-gold/30" aria-hidden="true">·</span>
        </span>
      ))
    }
  </div>
</section>
