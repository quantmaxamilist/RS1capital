---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { footerLinks, social } from '../data/site';

interface Props {
  onHome?: boolean;
}

const { onHome = true } = Astro.props;
const resolve = (href: string) => (!onHome && href.startsWith('#') ? `/${href}` : href);
---

<footer class="relative bg-black pt-20 pb-8 overflow-hidden" aria-label="Site footer">
  <div class="absolute bottom-0 left-0 w-1/2 h-1/2 glow-gold-bottom-left pointer-events-none opacity-40" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-10 relative">
    <div class="grid md:grid-cols-3 gap-12 mb-16 items-start">
      <div>
        <Logo variant="mark" />
      </div>

      <div class="font-body text-sm text-mist/70 leading-relaxed text-center md:text-left space-y-6">
        <p>
          <a href="mailto:info@rs1.uk" class="text-gold hover:underline">info@rs1.uk</a>
        </p>
        <address class="not-italic">
          <strong class="text-mist block mb-1">Spain</strong>
          RS1 Capital Limited<br />
          C/ San Fernando 34<br />
          07702 Mahón, Balearic Islands
        </address>
        <address class="not-italic">
          <strong class="text-mist block mb-1">United Kingdom</strong>
          RS1 Capital Limited<br />
          160 City Road<br />
          London, EC1V 2NX
        </address>
      </div>

      <nav class="grid grid-cols-2 gap-x-8 gap-y-3 justify-items-end md:justify-items-start md:ml-auto" aria-label="Footer navigation">
        <div class="flex flex-col gap-3">
          {
            footerLinks.col1.map((link) => (
              <a href={resolve(link.href)} class="nav-link font-body text-xs font-medium tracking-wide text-mist/60 uppercase">
                {link.label}
              </a>
            ))
          }
        </div>
        <div class="flex flex-col gap-3">
          {
            footerLinks.col2.map((link) => (
              <a href={resolve(link.href)} class="nav-link font-body text-xs font-medium tracking-wide text-mist/60 uppercase">
                {link.label}
              </a>
            ))
          }
        </div>
      </nav>
    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
      {/* LinkedIn shows only once a verified URL is set in data/site.ts (social.linkedin).
          Until then an empty box of the same size keeps the row laid out as before. */}
      {
        social.linkedin ? (
          <div class="flex items-center gap-4">
            <a
              href={social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-mist/50 hover:text-gold transition-colors w-10 h-10 flex items-center justify-center"
              aria-label="RS1 Capital on LinkedIn"
            >
              <Icon name="linkedin-in" class="text-lg" />
            </a>
          </div>
        ) : (
          <div class="hidden md:block w-10 h-10" aria-hidden="true" />
        )
      }

      <p class="font-body text-xs text-mist/60">
        © 2026 RS1 Capital Limited. All rights reserved.
      </p>

      <a href="/privacy" class="font-body text-xs text-mist/60 hover:text-gold transition-colors">
        Privacy
      </a>
    </div>
  </div>
</footer>
