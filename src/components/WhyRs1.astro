---
import { whyRs1 } from '../data/site';
---

<section
  id="why"
  class="relative bg-ivory py-24 lg:py-32 overflow-hidden"
  aria-labelledby="why-heading"
>
  <div class="absolute top-0 left-0 w-24 h-24 hatch-corner opacity-40 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-0 right-0 w-24 h-24 hatch-corner opacity-40 pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-10 relative">
    <p class="eyebrow mb-4" data-reveal>Why RS1</p>
    <h2
      id="why-heading"
      class="heading-display text-[clamp(2rem,4vw,3rem)] text-black mb-14 max-w-2xl"
      data-reveal
    >
      A partner built for speed, certainty and pragmatism.
    </h2>

    <ul
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-8"
      data-reveal-group
      data-reveal-stagger="0.09"
    >
      {
        whyRs1.map((point) => (
          <li class="flex items-start gap-4 border-t border-black/10 pt-5" data-reveal>
            <svg
              class="shrink-0 mt-1 w-5 h-5 text-gold"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 10.5l4 4 8-9"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="font-body text-base lg:text-lg text-black/80 leading-snug">{point}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
