---
import { services } from '../data/site';
---

<section id="services" class="bg-white py-24 lg:py-32" aria-labelledby="services-heading">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="flex items-start justify-between gap-6 mb-12">
      <h2
        id="services-heading"
        class="heading-display text-[clamp(2rem,4vw,3rem)] text-black"
        data-reveal
      >
        Services
      </h2>
    </div>

    <div class="portfolio-strip" role="list" data-reveal-group data-reveal-stagger="0.08">
      {
        services.map((service) => (
          <article
            class="portfolio-card hover-lift-card relative bg-black group"
            role="listitem"
            tabindex="0"
            data-service={service.id}
            data-reveal
            aria-label={service.name}
          >
            <!-- Abstract gold-on-black placeholder panel -->
            <div
              class="absolute inset-0 bg-cover bg-center transition-opacity duration-[400ms]"
              style={{ background: service.gradient }}
              role="img"
              aria-label={`${service.name} — abstract placeholder panel`}
            ></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent"></div>

            <!-- Collapsed state: service name -->
            <div class="collapsed-label absolute inset-0 flex items-center justify-center p-4 transition-opacity duration-[400ms] group-hover:opacity-0 group-focus-within:opacity-0">
              <span class="font-display text-lg lg:text-xl font-semibold text-gold/80 tracking-wide text-center [writing-mode:vertical-rl] rotate-180 lg:[writing-mode:horizontal-tb] lg:rotate-0 leading-snug">
                {service.name}
              </span>
            </div>

            <!-- Expanded content -->
            <div class="expanded-content absolute inset-0 flex flex-col justify-end p-6 lg:p-8 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-[400ms] pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto">
              <p class="font-display text-2xl lg:text-3xl font-semibold text-mist mb-3">{service.name}</p>
              <p class="font-body text-sm text-mist/75 max-w-md leading-relaxed">{service.blurb}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- PLACEHOLDER: Case Studies content — link nav anchor until real case studies are added -->
<section id="case-studies" class="sr-only" aria-hidden="true">
  <p>Case studies — content to be added</p>
</section>

<style>
  .portfolio-card:first-child .collapsed-label {
    opacity: 0;
  }
  .portfolio-card:first-child .expanded-content {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 767px) {
    .portfolio-card .collapsed-label {
      opacity: 0;
    }
    .portfolio-card .expanded-content {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  document.querySelectorAll('.portfolio-card').forEach((card) => {
    card.addEventListener('mouseenter', () => {
      document.querySelectorAll('.portfolio-card').forEach((c) => {
        if (c !== card) {
          c.classList.add('peer-collapsed');
        }
      });
    });
  });
</script>
