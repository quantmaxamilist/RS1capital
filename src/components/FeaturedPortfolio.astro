---
import { services } from '../data/site';
---

<section id="services" class="bg-white py-24 lg:py-32" aria-labelledby="services-heading">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="flex items-start justify-between gap-6 mb-12">
      <h2
        id="services-heading"
        class="heading-display text-[clamp(2rem,4vw,3rem)] text-black"
        data-reveal
      >
        Services
      </h2>
    </div>

    <div class="portfolio-strip" role="list" data-reveal-group data-reveal-stagger="0.08">
      {
        services.map((service) => (
          <article
            class="portfolio-card hover-lift-card relative bg-black group"
            role="listitem"
            tabindex="0"
            data-service={service.id}
            data-reveal
            aria-label={service.name}
          >
            <div
              class="absolute inset-0 bg-cover bg-center transition-opacity duration-[400ms]"
              style={{ background: service.gradient }}
              role="img"
              aria-label={`${service.name} — abstract placeholder panel`}
            ></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent"></div>

            <!-- Collapsed: vertical/horizontal title only (desktop idle state) -->
            <div class="service-card__collapsed absolute inset-0 items-center justify-center p-4 transition-opacity duration-[400ms]">
              <span class="font-display text-lg lg:text-xl font-semibold text-gold/80 tracking-wide text-center [writing-mode:vertical-rl] rotate-180 lg:[writing-mode:horizontal-tb] lg:rotate-0 leading-snug">
                {service.name}
              </span>
            </div>

            <!-- Expanded: title + blurb -->
            <div class="service-card__expanded absolute inset-0 flex flex-col justify-end p-6 lg:p-8 transition-opacity duration-[400ms]">
              <p class="font-display text-2xl lg:text-3xl font-semibold text-mist mb-3">{service.name}</p>
              <p class="font-body text-sm text-mist/75 max-w-md leading-relaxed">{service.blurb}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Mobile: always show expanded panel only */
  .service-card__collapsed {
    display: none;
  }

  .service-card__expanded {
    display: flex;
    opacity: 1;
    pointer-events: auto;
  }

  @media (min-width: 768px) {
    .service-card__collapsed {
      display: flex;
      opacity: 1;
    }

    .service-card__expanded {
      display: none;
      opacity: 0;
      pointer-events: none;
    }

    /* First card open by default */
    .portfolio-card:first-child .service-card__collapsed {
      display: none;
    }

    .portfolio-card:first-child .service-card__expanded {
      display: flex;
      opacity: 1;
      pointer-events: auto;
    }

    /* Hover / focus expands */
    .portfolio-card:hover .service-card__collapsed,
    .portfolio-card:focus-within .service-card__collapsed {
      display: none;
    }

    .portfolio-card:hover .service-card__expanded,
    .portfolio-card:focus-within .service-card__expanded {
      display: flex;
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>

<script>
  document.querySelectorAll('.portfolio-card').forEach((card) => {
    card.addEventListener('mouseenter', () => {
      document.querySelectorAll('.portfolio-card').forEach((c) => {
        if (c !== card) {
          c.classList.add('peer-collapsed');
        }
      });
    });
  });
</script>
