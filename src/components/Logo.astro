---
interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;

const src = '/logo.png';
const imgClass = variant === 'mark' ? 'h-12 md:h-14 w-auto' : 'h-10 md:h-12 w-auto';
---

<a href="/" class:list={['inline-block', className]} aria-label="RS1 Capital home">
  <img src={src} alt="RS1 Capital" class={imgClass} width="160" height="48" />
</a>
