---
interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;

const src = '/logo.png';
const imgClass =
  variant === 'mark'
    ? 'h-12 md:h-14 w-auto max-w-[min(100%,220px)]'
    : 'h-14 md:h-16 w-auto max-w-[min(100%,220px)]';
---

<a href="/" class:list={['inline-flex items-center', className]} aria-label="RS1 Capital home">
  <img src={src} alt="RS1 Capital" class={imgClass} width="200" height="80" />
</a>
