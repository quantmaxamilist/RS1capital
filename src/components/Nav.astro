---
import Logo from './Logo.astro';
import { navLinks } from '../data/site';
---

<header
  id="site-header"
  class="fixed left-0 right-0 z-[100] transition-all duration-300"
  style="top: var(--announcement-height, 40px);"
>
  <nav
    id="main-nav"
    class="flex items-center justify-between px-6 lg:px-10 h-20 md:h-[5.5rem] transition-all duration-300"
    aria-label="Main navigation"
  >
    <Logo class="shrink-0" />

    <ul id="nav-desktop" class="hidden lg:flex items-center gap-6 xl:gap-8">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link font-body text-[0.6875rem] font-medium tracking-[0.12em] uppercase text-mist/70"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="nav-toggle"
      type="button"
      class="lg:hidden w-11 h-11 flex flex-col items-center justify-center gap-1.5 border border-white/15 rounded-sm"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="nav-bar block w-5 h-px bg-gold transition-all duration-300"></span>
      <span class="nav-bar block w-5 h-px bg-gold transition-all duration-300"></span>
      <span class="nav-bar block w-5 h-px bg-gold transition-all duration-300"></span>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="fixed inset-0 z-[99] bg-black/98 backdrop-blur-lg flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
    style="top: var(--announcement-height, 40px);"
    aria-hidden="true"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link nav-link font-display text-3xl font-semibold text-mist tracking-wide"
        >
          {link.label}
        </a>
      ))
    }
  </div>
</header>

<style>
  #main-nav.scrolled {
    background: rgba(8, 8, 8, 0.92);
    backdrop-filter: blur(12px);
    height: 4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  #main-nav.scrolled :global(img) {
    height: 2.75rem;
  }

  @media (min-width: 768px) {
    #main-nav.scrolled {
      height: 4.5rem;
    }

    #main-nav.scrolled :global(img) {
      height: 3.25rem;
    }
  }

  #mobile-menu.open {
    opacity: 1;
    pointer-events: auto;
  }

  #nav-toggle.open .nav-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #nav-toggle.open .nav-bar:nth-child(2) {
    opacity: 0;
  }
  #nav-toggle.open .nav-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const nav = document.getElementById('main-nav');
  const header = document.getElementById('site-header');

  function closeMenu(): void {
    toggle?.classList.remove('open');
    menu?.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('open');
    if (isOpen) {
      closeMenu();
    } else {
      toggle.classList.add('open');
      menu?.classList.add('open');
      toggle.setAttribute('aria-expanded', 'true');
      menu?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  function updateNavScroll(): void {
    const scrolled = window.scrollY > 40;
    nav?.classList.toggle('scrolled', scrolled);
  }

  window.addEventListener('scroll', updateNavScroll, { passive: true });
  updateNavScroll();

  window.addEventListener('announcement-dismissed', () => {
    if (header) {
      header.style.top = '0';
    }
  });
</script>
