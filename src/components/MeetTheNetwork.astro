---
import { networkMembers } from '../data/site';
---

<section id="network" class="bg-white py-24 lg:py-32" aria-labelledby="network-heading">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="flex items-start justify-between gap-6 mb-12">
      <h2 id="network-heading" class="heading-display text-[clamp(2rem,4vw,3rem)] text-navy">
        Meet the Network
      </h2>
      <a href="#network" class="view-all-pill shrink-0">VIEW ALL</a>
    </div>

    <!-- Replace placeholder portraits with real approved headshots -->
    <div id="network-rail" class="network-rail mb-10" role="list">
      {
        networkMembers.map((member) => (
          <article
            class="w-52 md:w-56 rounded-xl overflow-hidden relative aspect-[3/4] bg-gradient-to-b from-navy-2 to-ink shrink-0"
            role="listitem"
          >
            <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
              <i class="fa-solid fa-user text-4xl text-paper/15"></i>
              <span class="absolute font-display text-3xl font-semibold text-aqua/30">{member.initials}</span>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/30 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <p class="font-body font-semibold text-paper text-sm leading-tight">{member.name}</p>
              <p class="font-body text-xs text-paper/65 mt-1 leading-snug">{member.title}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="text-center">
      <a
        href="#network"
        class="inline-block font-body text-xs font-semibold tracking-[0.16em] uppercase bg-aqua text-ink px-8 py-3.5 rounded-sm hover:bg-aqua/90 transition-colors"
      >
        RSVP NOW
      </a>
    </div>
  </div>
</section>

<script>
  const rail = document.getElementById('network-rail');
  if (rail) {
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    rail.addEventListener('mousedown', (e: MouseEvent) => {
      isDown = true;
      startX = e.pageX - rail.offsetLeft;
      scrollLeft = rail.scrollLeft;
    });

    rail.addEventListener('mouseleave', () => {
      isDown = false;
    });

    rail.addEventListener('mouseup', () => {
      isDown = false;
    });

    rail.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - rail.offsetLeft;
      const walk = (x - startX) * 1.5;
      rail.scrollLeft = scrollLeft - walk;
    });
  }
</script>
