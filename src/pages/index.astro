<script>
function toggleMobileMenu() {
  const menu = document.getElementById('mobile-menu');
  const isOpen = menu.style.display === 'flex';
  menu.style.display = isOpen ? 'none' : 'flex';
}
document.addEventListener('DOMContentLoaded', () => {
  const hamburger = document.getElementById('hamburger');
  if (hamburger) {
    hamburger.style.minWidth = '44px';
    hamburger.style.minHeight = '44px';
    hamburger.style.justifyContent = 'center';
    hamburger.addEventListener('click', toggleMobileMenu);
    hamburger.addEventListener('touchend', e => {
      e.preventDefault();
      e.stopPropagation();
      toggleMobileMenu();
    });
  }
});
</script>

<script type="module">
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import Lenis from '@studio-freight/lenis';

gsap.registerPlugin(ScrollTrigger);

gsap.set('#hero-label', { opacity:0, y:10 });
gsap.set('.hero-word', { opacity:0, y:60, rotateX:-30 });
gsap.set('#hero-sub', { opacity:0, y:20 });
gsap.set('#hero-pills', { opacity:0, y:20 });
gsap.set('#hero-ctas', { opacity:0, y:20 });
gsap.set('#hero-right > div', { opacity:0, x:30 });

const lenis = new Lenis({ lerp:0.08, smoothWheel:true, syncTouch:true });
lenis.on('scroll', ScrollTrigger.update);
gsap.ticker.add(time => lenis.raf(time * 1000));
gsap.ticker.lagSmoothing(0);

const tl = gsap.timeline({ delay:0.3 });
tl.to('#hero-label', { opacity:1, y:0, duration:0.8, ease:'power3.out' })
  .to('.hero-word', { opacity:1, y:0, rotateX:0, stagger:0.12, duration:1.1, ease:'power3.out', transformOrigin:'center bottom' }, '-=0.5')
  .to('#hero-sub',   { opacity:1, y:0, duration:0.7, ease:'power2.out' }, '-=0.4')
  .to('#hero-pills', { opacity:1, y:0, duration:0.6, ease:'power2.out' }, '-=0.4')
  .to('#hero-ctas',  { opacity:1, y:0, duration:0.6, ease:'power2.out' }, '-=0.3')
  .to('#hero-right > div', { opacity:1, x:0, stagger:0.1, duration:0.8, ease:'power3.out' }, '-=0.5');

gsap.utils.toArray('.reveal').forEach(el => {
  gsap.fromTo(el,
    { y:40, opacity:0 },
    { y:0, opacity:1, duration:0.9, ease:'power2.out',
      scrollTrigger:{ trigger:el, start:'top 90%', toggleActions:'play none none none' }
    }
  );
});

window.addEventListener('load', () => {
  document.querySelectorAll('.stat-counter').forEach(item => {
    const target = parseInt(item.getAttribute('data-target') || '0', 10);
    const numEl = item.querySelector('.count-num');
    if (!numEl || target === 0) return;
    let current = 0;
    const step = target / 60;
    const timer = setInterval(() => {
      current += step;
      if (current >= target) { current = target; clearInterval(timer); }
      numEl.textContent = Math.round(current).toString();
    }, 30);
  });
});
</script>
