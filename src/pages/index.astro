---
import Layout from '../layouts/Layout.astro';
import LogoMark from '../components/LogoMark.astro';

const NAVY = '#02184a';
const NAVY_LIGHT = '#032060';
const RED = '#f70200';

const services = [
  { num: '01', name: 'Kitchen Fitting', desc: 'Bespoke kitchen installation from layout to final fix — units, worktops and finishing details done to a high standard.' },
  { num: '02', name: '1st & 2nd Fix Carpentry', desc: 'Structural and finishing carpentry for new builds, extensions and renovations — stud work, door linings, skirting and more.' },
  { num: '03', name: 'Bespoke Staircases & Joinery', desc: 'Custom staircases, feature panelling and made-to-measure joinery tailored to your space and specification.' },
  { num: '04', name: 'Traditional Cut & Trussed Roofing', desc: 'Cut and trussed roof structures installed with precision — domestic and commercial projects across Pembrokeshire.' },
  { num: '05', name: 'CIS Contracting', desc: 'Reliable CIS-registered carpentry contracting for builders, developers and trade clients.' },
  { num: '06', name: 'Domestic & Commercial Work', desc: 'All aspects of carpentry for homeowners and commercial clients — no job too small, quality on every project.' },
];

const galleryItems = [
  { src: '/gallery/project-a1.jpg', alt: 'Vertical slat wood panelling feature wall joinery, J.L. Hughes Carpentry' },
  { src: '/gallery/project-a2.jpg', alt: 'Bespoke vertical wood slat panelling installation, Pembrokeshire' },
  { src: '/gallery/project-a3.jpg', alt: 'Feature wall joinery with vertical timber slats' },
  { src: '/gallery/project-b1.jpg', alt: 'Bespoke kitchen fitting in progress, J.L. Hughes Carpentry' },
  { src: '/gallery/project-b2.jpg', alt: 'Kitchen cabinet installation, Haverfordwest' },
  { src: '/gallery/project-b3.jpg', alt: 'Kitchen fitting project, Pembrokeshire carpentry' },
];

const featuredImages = [
  { src: '/gallery/project-b1.jpg', label: 'Kitchen units — in progress' },
  { src: '/gallery/project-b2.jpg', label: 'Cabinet fitting & alignment' },
  { src: '/gallery/project-b3.jpg', label: 'Final fix detail' },
];

const marqueeItems = [
  'Kitchen Fitting',
  '1st & 2nd Fix',
  'Bespoke Joinery',
  'Staircases',
  'Roofing',
  'CIS Contracting',
  'Pembrokeshire',
  'Free Quotes',
];

// Stats placeholders — awaiting confirmed figures from the business
const stats = [
  { num: 0, label: 'Years Experience', suffix: 'yr', placeholder: true },
  { num: 0, label: 'Projects Completed', suffix: '+', placeholder: true },
  { num: 0, label: 'Cost to Quote', suffix: '£', placeholder: false },
];

const highlights = [
  { title: 'Kitchen Fitting', desc: 'Full kitchen installations from first fix through to final details — domestic and commercial.' },
  { title: 'Bespoke Joinery', desc: 'Feature walls, staircases and custom timber work built to your specification.' },
  { title: 'Pembrokeshire Based', desc: 'Serving Haverfordwest and across Pembrokeshire for domestic and commercial carpentry.' },
];

const currentYear = new Date().getFullYear();
---
<Layout>

<!-- PROMO BAR -->
<div style={`background:${RED};color:#ffffff;text-align:center;padding:9px 16px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.14em;text-transform:uppercase;font-weight:600;`}>
  Carpenter · Haverfordwest · Pembrokeshire · <a href="tel:07495471877" style="color:#ffffff;font-weight:700;text-decoration:none;">07495 471877</a>
</div>

<!-- NAV -->
<nav style="position:fixed;top:37px;left:0;right:0;z-index:100;">
  <div style={`background:rgba(2,24,74,0.97);backdrop-filter:blur(20px);border-bottom:0.5px solid rgba(255,255,255,0.12);height:60px;display:flex;align-items:center;justify-content:space-between;padding:0 40px;width:100%;box-sizing:border-box;`}>
    <a href="/" style="display:flex;align-items:center;text-decoration:none;flex-shrink:0;">
      <LogoMark compact />
    </a>
    <div id="nav-desktop" style="display:flex;gap:28px;position:absolute;left:50%;transform:translateX(-50%);">
      <a href="#services" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.6);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;">Services</a>
      <a href="#featured" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.6);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;">Featured</a>
      <a href="#projects" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.6);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;">Gallery</a>
      <a href="#reviews" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.6);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;">Reviews</a>
      <a href="#find-us" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.6);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;">Find Us</a>
      <a href="#contact" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.6);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;">Contact</a>
    </div>
    <div style="display:flex;align-items:center;gap:12px;">
      <a href="tel:07495471877" style={`font-family:'JetBrains Mono',monospace;font-size:10px;background:${RED};color:#ffffff;padding:10px 20px;border-radius:1px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;white-space:nowrap;flex-shrink:0;`}>07495 471877</a>
      <button id="hamburger" onclick="toggleMobileMenu()" style="background:none;border:0.5px solid rgba(255,255,255,0.25);padding:10px 12px;border-radius:1px;cursor:pointer;display:none;flex-direction:column;gap:5px;align-items:center;flex-shrink:0;">
        <span style={`display:block;width:18px;height:1.5px;background:${RED};`}></span>
        <span style={`display:block;width:18px;height:1.5px;background:${RED};`}></span>
        <span style={`display:block;width:18px;height:1.5px;background:${RED};`}></span>
      </button>
    </div>
  </div>
  <div id="mobile-menu" style={`display:none;background:rgba(2,24,74,0.99);border-bottom:0.5px solid rgba(255,255,255,0.12);flex-direction:column;gap:0;`}>
    <a href="#services" onclick="toggleMobileMenu()" style="font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(255,255,255,0.7);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;padding:18px 28px;border-bottom:0.5px solid rgba(255,255,255,0.08);">Services</a>
    <a href="#featured" onclick="toggleMobileMenu()" style="font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(255,255,255,0.7);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;padding:18px 28px;border-bottom:0.5px solid rgba(255,255,255,0.08);">Featured</a>
    <a href="#projects" onclick="toggleMobileMenu()" style="font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(255,255,255,0.7);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;padding:18px 28px;border-bottom:0.5px solid rgba(255,255,255,0.08);">Gallery</a>
    <a href="#reviews" onclick="toggleMobileMenu()" style="font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(255,255,255,0.7);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;padding:18px 28px;border-bottom:0.5px solid rgba(255,255,255,0.08);">Reviews</a>
    <a href="#find-us" onclick="toggleMobileMenu()" style="font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(255,255,255,0.7);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;padding:18px 28px;border-bottom:0.5px solid rgba(255,255,255,0.08);">Find Us</a>
    <a href="#contact" onclick="toggleMobileMenu()" style={`font-family:'JetBrains Mono',monospace;font-size:11px;color:${RED};text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;padding:18px 28px;`}>Get a Free Quote</a>
  </div>
</nav>

<!-- HERO -->
<section id="hero" style="min-height:100svh;display:flex;align-items:center;position:relative;overflow:hidden;padding:0 40px;">
  <div style="position:absolute;inset:0;z-index:0;animation:brickReveal 2.5s cubic-bezier(0.16,1,0.3,1) 0.3s both,slowZoom 10s ease-out 0.3s both;background-image:url('/gallery/project-a1.jpg');background-size:cover;background-position:center;filter:brightness(0.15) saturate(0.5);"></div>
  <div style={`position:absolute;inset:0;z-index:1;background:linear-gradient(to right,rgba(2,24,74,0.9) 0%,rgba(2,24,74,0.4) 60%,transparent 100%);pointer-events:none;`}></div>
  <div style="position:absolute;inset:0;z-index:1;background:radial-gradient(ellipse at 80% 50%,rgba(247,2,0,0.06) 0%,transparent 60%);pointer-events:none;"></div>

  <div style="position:relative;z-index:2;max-width:1400px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;padding-top:100px;padding-bottom:80px;min-height:100svh;">
    <div style="display:flex;flex-direction:column;justify-content:center;">
      <div id="hero-label" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.55);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:24px;display:flex;align-items:center;gap:12px;">
        <span style={`display:block;width:32px;height:0.5px;background:${RED};`}></span>
        Haverfordwest · Pembrokeshire
      </div>
      <h1 style="font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,8vw,120px);color:#ffffff;line-height:0.88;letter-spacing:0.01em;margin-bottom:28px;">
        <span class="hero-word" style="display:block;">Carpentry</span>
        <span class="hero-word" style="display:block;color:rgba(255,255,255,0.25);">Built to</span>
        <span class="hero-word" style="display:block;">Last.</span>
      </h1>
      <p id="hero-sub" style="font-size:15px;color:rgba(255,255,255,0.5);max-width:440px;line-height:1.8;margin-bottom:32px;">Kitchen fitting, bespoke staircases, joinery and roofing across Pembrokeshire — quality carpentry for domestic and commercial clients.</p>
      <div id="hero-pills" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:36px;">
        {['Kitchen Fitting','1st & 2nd Fix','Joinery','Roofing','CIS Contracting'].map(s => (
          <span style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(255,255,255,0.45);border:0.5px solid rgba(255,255,255,0.15);padding:6px 12px;border-radius:1px;letter-spacing:0.08em;text-transform:uppercase;">{s}</span>
        ))}
      </div>
      <div id="hero-ctas" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
        <a href="tel:07495471877" data-hover style={`background:${RED};color:#ffffff;font-family:'JetBrains Mono',monospace;font-size:11px;padding:14px 28px;border-radius:1px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;`}>Get a Free Quote</a>
        <a href="#projects" data-hover style="background:transparent;color:#ffffff;font-family:'JetBrains Mono',monospace;font-size:11px;padding:14px 28px;border-radius:1px;border:0.5px solid rgba(255,255,255,0.15);letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;">See Our Work →</a>
      </div>
    </div>

    <div id="hero-right" style="display:flex;flex-direction:column;gap:12px;align-items:flex-end;justify-content:center;">
      {[['Kitchen','Fitting Specialists'],['Joinery','Bespoke Work'],['Roofing','Cut & Trussed'],['CIS','Registered']].map(([num,label]) => (
        <div style={`background:rgba(3,32,96,0.85);border:0.5px solid rgba(255,255,255,0.12);padding:18px 24px;border-radius:1px;display:flex;align-items:center;gap:16px;backdrop-filter:blur(10px);width:280px;`}>
          <span style={`font-family:'Bebas Neue',sans-serif;font-size:28px;color:${RED};letter-spacing:0.04em;line-height:1;`}>{num}</span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(255,255,255,0.4);letter-spacing:0.08em;text-transform:uppercase;">{label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div style={`border-top:0.5px solid rgba(255,255,255,0.1);border-bottom:0.5px solid rgba(255,255,255,0.1);padding:14px 0;overflow:hidden;background:${NAVY_LIGHT};`}>
  <div id="marquee" style="display:flex;gap:48px;width:max-content;animation:marqueeScroll 28s linear infinite;">
    {[...Array(4)].flatMap(() => marqueeItems.map(item => (
      <span style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.35);letter-spacing:0.16em;text-transform:uppercase;white-space:nowrap;display:inline-flex;align-items:center;gap:48px;">{item}<span style="opacity:0.3;">·</span></span>
    )))}
  </div>
</div>

<!-- SERVICES -->
<section id="services" style="padding:120px 40px;border-top:0.5px solid rgba(255,255,255,0.08);">
  <div style="max-width:1400px;margin:0 auto;">
    <p class="reveal" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.35);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:10px;">// 01 — What we do</p>
    <h2 class="reveal" style="font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,6vw,88px);color:#ffffff;letter-spacing:0.02em;margin-bottom:56px;line-height:0.95;">Services</h2>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
      {services.map(s => (
        <div class="reveal" data-hover style={`background:${NAVY_LIGHT};border:0.5px solid rgba(255,255,255,0.1);border-radius:1px;padding:36px 32px;transition:border-color 0.3s,background 0.3s;`} onmouseenter={`this.style.borderColor='rgba(247,2,0,0.35)';this.style.background='#042a72'`} onmouseleave={`this.style.borderColor='rgba(255,255,255,0.1)';this.style.background='${NAVY_LIGHT}'`}>
          <p style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(255,255,255,0.2);letter-spacing:0.12em;margin-bottom:32px;">{s.num}</p>
          <h3 style="font-family:'Bebas Neue',sans-serif;font-size:28px;color:#ffffff;letter-spacing:0.03em;margin-bottom:12px;">{s.name}</h3>
          <p style="font-size:13px;color:rgba(255,255,255,0.4);line-height:1.75;">{s.desc}</p>
        </div>
      ))}
      <div class="reveal" style={`background:${RED};border-radius:1px;padding:36px 32px;display:flex;flex-direction:column;justify-content:space-between;`}>
        <div>
          <p style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(255,255,255,0.65);letter-spacing:0.12em;margin-bottom:32px;">FREE QUOTE</p>
          <h3 style={`font-family:'Bebas Neue',sans-serif;font-size:28px;color:#ffffff;letter-spacing:0.03em;margin-bottom:12px;`}>Ready to start?</h3>
          <p style="font-size:13px;color:rgba(255,255,255,0.75);line-height:1.75;">Free quotes, no obligation. We get back same day.</p>
        </div>
        <a href="tel:07495471877" data-hover style={`background:${NAVY};color:#ffffff;font-family:'JetBrains Mono',monospace;font-size:10px;padding:13px 18px;border-radius:1px;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;display:inline-block;margin-top:28px;width:fit-content;`}>Call 07495 471877 →</a>
      </div>
    </div>
  </div>
</section>

<!-- FEATURED WORK -->
<section id="featured" style={`padding:120px 40px;border-top:0.5px solid rgba(255,255,255,0.08);background:${NAVY_LIGHT};`}>
  <div style="max-width:1400px;margin:0 auto;">
    <p class="reveal" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.35);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:10px;">// 02 — Signature work</p>
    <h2 class="reveal" style="font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,6vw,88px);color:#ffffff;letter-spacing:0.02em;margin-bottom:16px;line-height:0.95;">Bespoke Kitchen Fitting</h2>
    <p class="reveal" style="font-size:14px;color:rgba(255,255,255,0.45);max-width:560px;line-height:1.75;margin-bottom:56px;">From first fix through to final details — precision cabinet installation and finishing for domestic kitchens across Pembrokeshire.</p>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
      {featuredImages.map(img => (
        <div class="reveal" style="position:relative;overflow:hidden;border-radius:1px;border:0.5px solid rgba(255,255,255,0.1);">
          <img src={img.src} alt={img.label} style="width:100%;display:block;aspect-ratio:4/3;object-fit:cover;" loading="lazy" />
          <div style={`position:absolute;inset:0;background:linear-gradient(to top,rgba(2,24,74,0.85) 0%,transparent 55%);pointer-events:none;`}></div>
          <div style="position:absolute;bottom:14px;left:16px;">
            <span style={`font-family:'JetBrains Mono',monospace;font-size:9px;color:${RED};letter-spacing:0.1em;text-transform:uppercase;`}>{img.label}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- GALLERY -->
<section id="projects" style="padding:120px 40px;border-top:0.5px solid rgba(255,255,255,0.08);">
  <div style="max-width:1400px;margin:0 auto;">
    <p class="reveal" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.35);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:10px;">// 03 — Our work</p>
    <h2 class="reveal" style="font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,6vw,88px);color:#ffffff;letter-spacing:0.02em;margin-bottom:56px;line-height:0.95;">Gallery</h2>
    <div style="columns:2;gap:8px;">
      {galleryItems.map((p, i) => (
        <button
          type="button"
          class="reveal gallery-trigger"
          data-index={i}
          style="break-inside:avoid;margin-bottom:8px;position:relative;overflow:hidden;border-radius:1px;border:0.5px solid rgba(255,255,255,0.1);width:100%;padding:0;background:none;cursor:pointer;display:block;"
          data-hover
        >
          <img src={p.src} alt={p.alt} style="width:100%;display:block;transition:transform 0.7s,filter 0.5s;" loading="lazy" />
          <div style={`position:absolute;inset:0;background:linear-gradient(to top,rgba(2,24,74,0.75) 0%,transparent 50%);pointer-events:none;`}></div>
        </button>
      ))}
    </div>
  </div>
</section>

<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Image preview">
  <button id="lightbox-close" type="button" style="position:absolute;top:24px;right:24px;background:none;border:none;color:rgba(255,255,255,0.8);font-size:32px;cursor:pointer;" aria-label="Close">&times;</button>
  <img id="lightbox-img" src="" alt="" />
</div>

<!-- STATS -->
<div style={`display:grid;grid-template-columns:repeat(3,1fr);border-top:0.5px solid rgba(255,255,255,0.08);border-bottom:0.5px solid rgba(255,255,255,0.08);background:${NAVY};`}>
  {stats.map((s,i) => (
    <div class="stat-counter reveal" data-target={String(s.num)} style={`padding:56px 36px;${i<2?'border-right:0.5px solid rgba(255,255,255,0.08);':''}`}>
      <div style="font-family:'Bebas Neue',sans-serif;font-size:clamp(56px,5vw,80px);color:#ffffff;letter-spacing:0.02em;line-height:1;margin-bottom:8px;">
        <span class="count-num">0</span><span style={`color:${RED};opacity:0.85;font-size:0.55em;`}>{s.suffix}</span>
      </div>
      <p style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(255,255,255,0.35);letter-spacing:0.16em;text-transform:uppercase;">{s.label}</p>
      {s.placeholder && (
        <p style="font-family:'JetBrains Mono',monospace;font-size:8px;color:rgba(255,255,255,0.2);letter-spacing:0.08em;margin-top:8px;">Awaiting confirmed figure</p>
      )}
    </div>
  ))}
</div>

<!-- HIGHLIGHTS -->
<section style={`padding:80px 40px;border-top:0.5px solid rgba(255,255,255,0.08);background:${NAVY_LIGHT};`}>
  <div style="max-width:1400px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
    {highlights.map(c => (
      <div class="reveal" style={`background:${NAVY};border:0.5px solid rgba(255,255,255,0.1);border-radius:1px;padding:32px 28px;`}>
        <div style={`width:32px;height:1px;background:${RED};opacity:0.6;margin-bottom:20px;`}></div>
        <h3 style={`font-family:'Bebas Neue',sans-serif;font-size:22px;color:${RED};letter-spacing:0.04em;margin-bottom:10px;`}>{c.title}</h3>
        <p style="font-size:13px;color:rgba(255,255,255,0.4);line-height:1.7;">{c.desc}</p>
      </div>
    ))}
  </div>
</section>

<!-- REVIEWS -->
<section id="reviews" style={`padding:120px 40px;border-top:0.5px solid rgba(255,255,255,0.08);background:${NAVY};`}>
  <div style="max-width:1400px;margin:0 auto;">
    <p class="reveal" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.35);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:10px;">// 04 — What clients say</p>
    <h2 class="reveal" style="font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,6vw,88px);color:#ffffff;letter-spacing:0.02em;margin-bottom:16px;line-height:0.95;">Reviews</h2>
    <div class="reveal" style={`background:${NAVY_LIGHT};border:0.5px solid rgba(255,255,255,0.1);border-radius:1px;padding:48px 40px;text-align:center;`}>
      <p style="font-size:15px;color:rgba(255,255,255,0.45);line-height:1.8;max-width:480px;margin:0 auto;">Client reviews will appear here once collected. If you've worked with J.L. Hughes Carpentry, we'd love to hear from you.</p>
    </div>
  </div>
</section>

<!-- FIND US -->
<section id="find-us" style={`padding:120px 40px;border-top:0.5px solid rgba(255,255,255,0.08);background:${NAVY_LIGHT};`}>
  <div style="max-width:1400px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;">
    <div>
      <p class="reveal" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.35);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:10px;">// 05 — Visit us</p>
