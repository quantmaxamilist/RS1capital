---
import Layout from '../layouts/Layout.astro';

const services = [
  { num: '01', name: 'Silicon Rendering', desc: 'Certified Johnstones silicon render specialists. Weather-resistant, long-lasting finish in any colour.' },
  { num: '02', name: 'EWI Systems', desc: 'EWI registered installers. External wall insulation that improves energy efficiency and transforms your property.' },
  { num: '03', name: 'Internal Plastering', desc: 'Smooth skim finish on walls and ceilings. New builds, renovations and patch repairs done right.' },
  { num: '04', name: 'External Rendering', desc: 'Traditional sand and cement render or modern through-colour systems applied to any substrate.' },
  { num: '05', name: 'Dry Lining', desc: 'Stud walls, dot and dab and plasterboard systems installed cleanly and efficiently.' },
];

const photos = [
  { src: '/gallery/3.jpg', label: 'Plasterer at Work' },
  { src: '/gallery/after1.jpg', label: 'Silicon Render — Complete' },
  { src: '/gallery/after2.jpg', label: 'External Render — Complete' },
];

const beforeAfter = [
  { before: '/gallery/before1.jpg', after: '/gallery/after1.jpg', label: 'Silicon Render Transformation' },
  { before: '/gallery/before2.jpg', after: '/gallery/after2.jpg', label: 'Full External Render' },
];

const marqueeItems = ['Silicon Render','EWI Systems','Internal Plastering','External Render','Dry Lining','Free Quotes','17 Years Experience','Certified Specialists'];

const stats = [
  { num: 17, label: 'Years Experience', suffix: 'yr' },
  { num: 100, label: 'Five-Star Reviews', suffix: '%' },
  { num: 0, label: 'Cost to Quote', suffix: '£' },
];
---
<Layout>

<!-- PROMO BAR -->
<div style="background:#c0c8d8;color:#0d1b3e;text-align:center;padding:9px 16px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.14em;text-transform:uppercase;font-weight:600;">
  ⚡ Certified Johnstones Silicon Render Specialists · <a href="tel:07908641834" style="color:#0d1b3e;font-weight:700;text-decoration:none;">07908 641834</a>
</div>

<!-- NAV -->
<nav style="position:fixed;top:37px;left:0;right:0;z-index:100;">
  <div style="background:rgba(13,27,62,0.97);backdrop-filter:blur(20px);border-bottom:0.5px solid rgba(192,200,216,0.15);height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 40px;width:100%;box-sizing:border-box;">
    <a href="/" style="display:flex;align-items:center;gap:12px;text-decoration:none;flex-shrink:0;">
      <img src="/logo.jpg" alt="Nathan Staples Plastering" style="height:56px;object-fit:contain;" />
    </a>
    <div id="nav-desktop" style="display:flex;gap:28px;position:absolute;left:50%;transform:translateX(-50%);">
      <a href="#services" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.6);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;">Services</a>
      <a href="#projects" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.6);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;">Projects</a>
      <a href="#before-after" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.6);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;">Transformations</a>
      <a href="#reviews" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.6);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;">Reviews</a>
      <a href="#contact" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.6);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;">Contact</a>
    </div>
    <div style="display:flex;align-items:center;gap:12px;">
      <a href="tel:07908641834" style="font-family:'JetBrains Mono',monospace;font-size:10px;background:#c0c8d8;color:#0d1b3e;padding:10px 20px;border-radius:1px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;white-space:nowrap;flex-shrink:0;">07908 641834</a>
      <button id="hamburger" onclick="toggleMobileMenu()" style="background:none;border:0.5px solid rgba(192,200,216,0.3);padding:10px 12px;border-radius:1px;cursor:pointer;display:none;flex-direction:column;gap:5px;align-items:center;flex-shrink:0;">
        <span style="display:block;width:18px;height:1.5px;background:#c0c8d8;"></span>
        <span style="display:block;width:18px;height:1.5px;background:#c0c8d8;"></span>
        <span style="display:block;width:18px;height:1.5px;background:#c0c8d8;"></span>
      </button>
    </div>
  </div>
  <div id="mobile-menu" style="display:none;background:rgba(13,27,62,0.99);border-bottom:0.5px solid rgba(192,200,216,0.15);flex-direction:column;gap:0;">
    <a href="#services" onclick="toggleMobileMenu()" style="font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(255,255,255,0.7);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;padding:18px 28px;border-bottom:0.5px solid rgba(192,200,216,0.08);">Services</a>
    <a href="#projects" onclick="toggleMobileMenu()" style="font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(255,255,255,0.7);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;padding:18px 28px;border-bottom:0.5px solid rgba(192,200,216,0.08);">Projects</a>
    <a href="#before-after" onclick="toggleMobileMenu()" style="font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(255,255,255,0.7);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;padding:18px 28px;border-bottom:0.5px solid rgba(192,200,216,0.08);">Transformations</a>
    <a href="#reviews" onclick="toggleMobileMenu()" style="font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(255,255,255,0.7);text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;padding:18px 28px;border-bottom:0.5px solid rgba(192,200,216,0.08);">Reviews</a>
    <a href="#contact" onclick="toggleMobileMenu()" style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#c0c8d8;text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;padding:18px 28px;">Get a Free Quote</a>
  </div>
</nav>

<!-- HERO -->
<section id="hero" style="min-height:100svh;display:flex;align-items:center;position:relative;overflow:hidden;padding:0 40px;">
  <div style="position:absolute;inset:0;z-index:0;animation:brickReveal 2.5s cubic-bezier(0.16,1,0.3,1) 0.3s both,slowZoom 10s ease-out 0.3s both;background-image:url('/gallery/after1.jpg');background-size:cover;background-position:center;filter:brightness(0.15) saturate(0.5);"></div>
  <div style="position:absolute;inset:0;z-index:1;background:linear-gradient(to right,rgba(13,27,62,0.9) 0%,rgba(13,27,62,0.4) 60%,transparent 100%);pointer-events:none;"></div>
  <div style="position:absolute;inset:0;z-index:1;background:radial-gradient(ellipse at 80% 50%,rgba(192,200,216,0.05) 0%,transparent 60%);pointer-events:none;"></div>

  <div style="position:relative;z-index:2;max-width:1400px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;padding-top:100px;padding-bottom:80px;min-height:100svh;">
    <div style="display:flex;flex-direction:column;justify-content:center;">
      <div id="hero-label" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(192,200,216,0.6);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:24px;display:flex;align-items:center;gap:12px;">
        <span style="display:block;width:32px;height:0.5px;background:rgba(192,200,216,0.6);"></span>
        Cardiff · South Wales · Est. 17 Years
      </div>
      <h1 style="font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,8vw,120px);color:#ffffff;line-height:0.88;letter-spacing:0.01em;margin-bottom:28px;">
        <span class="hero-word" style="display:block;">Plastering</span>
        <span class="hero-word" style="display:block;color:rgba(192,200,216,0.3);">done</span>
        <span class="hero-word" style="display:block;">properly.</span>
      </h1>
      <p id="hero-sub" style="font-size:15px;color:rgba(255,255,255,0.5);max-width:440px;line-height:1.8;margin-bottom:32px;">Certified Johnstones silicon render specialists and EWI registered contractors. 17 years of trade experience across South Wales.</p>
      <div id="hero-pills" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:36px;">
        {['Silicon Render','EWI Systems','Internal Plastering','External Render','Dry Lining'].map(s => (
          <span style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(192,200,216,0.5);border:0.5px solid rgba(192,200,216,0.15);padding:6px 12px;border-radius:1px;letter-spacing:0.08em;text-transform:uppercase;">{s}</span>
        ))}
      </div>
      <div id="hero-ctas" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
        <a href="tel:07908641834" data-hover style="background:#c0c8d8;color:#0d1b3e;font-family:'JetBrains Mono',monospace;font-size:11px;padding:14px 28px;border-radius:1px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;">Get a Free Quote</a>
        <a href="#projects" data-hover style="background:transparent;color:#ffffff;font-family:'JetBrains Mono',monospace;font-size:11px;padding:14px 28px;border-radius:1px;border:0.5px solid rgba(255,255,255,0.15);letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;">See Our Work →</a>
      </div>
    </div>

    <div id="hero-right" style="display:flex;flex-direction:column;gap:12px;align-items:flex-end;justify-content:center;">
      {[['17yr','Years Experience'],['100%','Five-Star Reviews'],['EWI','Registered'],['✓','Johnstones Certified']].map(([num,label]) => (
        <div style="background:rgba(22,37,82,0.85);border:0.5px solid rgba(192,200,216,0.15);padding:18px 24px;border-radius:1px;display:flex;align-items:center;gap:16px;backdrop-filter:blur(10px);width:280px;">
          <span style="font-family:'Bebas Neue',sans-serif;font-size:28px;color:#c0c8d8;letter-spacing:0.04em;line-height:1;">{num}</span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(255,255,255,0.4);letter-spacing:0.08em;text-transform:uppercase;">{label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div style="border-top:0.5px solid rgba(192,200,216,0.1);border-bottom:0.5px solid rgba(192,200,216,0.1);padding:14px 0;overflow:hidden;background:#162552;">
  <div id="marquee" style="display:flex;gap:48px;width:max-content;animation:marqueeScroll 28s linear infinite;">
    {[...Array(4)].flatMap(() => marqueeItems.map(item => (
      <span style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(192,200,216,0.4);letter-spacing:0.16em;text-transform:uppercase;white-space:nowrap;display:inline-flex;align-items:center;gap:48px;">{item}<span style="opacity:0.3;">·</span></span>
    )))}
  </div>
</div>

<!-- SERVICES -->
<section id="services" style="padding:120px 40px;border-top:0.5px solid rgba(192,200,216,0.08);">
  <div style="max-width:1400px;margin:0 auto;">
    <p class="reveal" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(192,200,216,0.4);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:10px;">// 01 — What we do</p>
    <h2 class="reveal" style="font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,6vw,88px);color:#ffffff;letter-spacing:0.02em;margin-bottom:56px;line-height:0.95;">Services</h2>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
      {services.map(s => (
        <div class="reveal" data-hover style="background:#162552;border:0.5px solid rgba(192,200,216,0.1);border-radius:1px;padding:36px 32px;transition:border-color 0.3s,background 0.3s;" onmouseenter="this.style.borderColor='rgba(192,200,216,0.3)';this.style.background='#1a2d5e'" onmouseleave="this.style.borderColor='rgba(192,200,216,0.1)';this.style.background='#162552'">
          <p style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(192,200,216,0.25);letter-spacing:0.12em;margin-bottom:32px;">{s.num}</p>
          <h3 style="font-family:'Bebas Neue',sans-serif;font-size:28px;color:#ffffff;letter-spacing:0.03em;margin-bottom:12px;">{s.name}</h3>
          <p style="font-size:13px;color:rgba(255,255,255,0.4);line-height:1.75;">{s.desc}</p>
        </div>
      ))}
      <div class="reveal" style="background:#c0c8d8;border-radius:1px;padding:36px 32px;display:flex;flex-direction:column;justify-content:space-between;">
        <div>
          <p style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(13,27,62,0.4);letter-spacing:0.12em;margin-bottom:32px;">FREE QUOTE</p>
          <h3 style="font-family:'Bebas Neue',sans-serif;font-size:28px;color:#0d1b3e;letter-spacing:0.03em;margin-bottom:12px;">Ready to start?</h3>
          <p style="font-size:13px;color:rgba(13,27,62,0.55);line-height:1.75;">Free quotes, no obligation. We get back same day.</p>
        </div>
        <a href="tel:07908641834" data-hover style="background:#0d1b3e;color:#c0c8d8;font-family:'JetBrains Mono',monospace;font-size:10px;padding:13px 18px;border-radius:1px;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;display:inline-block;margin-top:28px;width:fit-content;">Call 07908 641834 →</a>
      </div>
    </div>
  </div>
</section>

<!-- PROJECTS -->
<section id="projects" style="padding:120px 40px;border-top:0.5px solid rgba(192,200,216,0.08);">
  <div style="max-width:1400px;margin:0 auto;">
    <p class="reveal" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(192,200,216,0.4);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:10px;">// 02 — Our work</p>
    <h2 class="reveal" style="font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,6vw,88px);color:#ffffff;letter-spacing:0.02em;margin-bottom:56px;line-height:0.95;">Projects</h2>
    <div style="columns:2;gap:8px;">
      {photos.map((p, i) => (
        <div class="reveal" style="break-inside:avoid;margin-bottom:8px;position:relative;overflow:hidden;border-radius:1px;border:0.5px solid rgba(192,200,216,0.1);" data-hover>
          <img src={p.src} alt={p.label} style="width:100%;display:block;transition:transform 0.7s,filter 0.5s;" onmouseenter="this.style.transform='scale(1.04)';this.style.filter='brightness(1.1)'" onmouseleave="this.style.transform='scale(1)';this.style.filter='brightness(1)'" />
          <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(13,27,62,0.8) 0%,transparent 50%);pointer-events:none;"></div>
          <div style="position:absolute;bottom:14px;left:16px;">
            <span style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(192,200,216,0.7);letter-spacing:0.1em;text-transform:uppercase;">{p.label}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BEFORE & AFTER -->
<section id="before-after" style="padding:120px 40px;border-top:0.5px solid rgba(192,200,216,0.08);background:#162552;">
  <div style="max-width:1400px;margin:0 auto;">
    <p class="reveal" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(192,200,216,0.4);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:10px;">// 03 — Transformations</p>
    <h2 class="reveal" style="font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,6vw,88px);color:#ffffff;letter-spacing:0.02em;margin-bottom:56px;line-height:0.95;">Before & After</h2>
    <div style="display:flex;flex-direction:column;gap:48px;">
      {beforeAfter.map(b => (
        <div class="reveal">
          <p style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(192,200,216,0.4);letter-spacing:0.14em;text-transform:uppercase;margin-bottom:16px;">{b.label}</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
            <div style="position:relative;overflow:hidden;border-radius:1px;border:0.5px solid rgba(192,200,216,0.1);">
              <img src={b.before} alt="Before" style="width:100%;display:block;" />
              <div style="position:absolute;top:14px;left:16px;background:rgba(13,27,62,0.85);padding:5px 12px;border-radius:1px;">
                <span style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(192,200,216,0.7);letter-spacing:0.1em;text-transform:uppercase;">Before</span>
              </div>
            </div>
            <div style="position:relative;overflow:hidden;border-radius:1px;border:0.5px solid rgba(192,200,216,0.1);">
              <img src={b.after} alt="After" style="width:100%;display:block;" />
              <div style="position:absolute;top:14px;left:16px;background:rgba(192,200,216,0.9);padding:5px 12px;border-radius:1px;">
                <span style="font-family:'JetBrains Mono',monospace;font-size:9px;color:#0d1b3e;letter-spacing:0.1em;text-transform:uppercase;">After</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- STATS -->
<div style="display:grid;grid-template-columns:repeat(3,1fr);border-top:0.5px solid rgba(192,200,216,0.08);border-bottom:0.5px solid rgba(192,200,216,0.08);background:#0d1b3e;">
  {stats.map((s,i) => (
    <div class="stat-counter reveal" data-target={String(s.num)} style={`padding:56px 36px;${i<2?'border-right:0.5px solid rgba(192,200,216,0.08);':''}`}>
      <div style="font-family:'Bebas Neue',sans-serif;font-size:clamp(56px,5vw,80px);color:#ffffff;letter-spacing:0.02em;line-height:1;margin-bottom:8px;">
        <span class="count-num">0</span><span style="opacity:0.3;font-size:0.55em;">{s.suffix}</span>
      </div>
      <p style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(192,200,216,0.35);letter-spacing:0.16em;text-transform:uppercase;">{s.label}</p>
    </div>
  ))}
</div>

<!-- CERTIFICATIONS -->
<section style="padding:80px 40px;border-top:0.5px solid rgba(192,200,216,0.08);background:#162552;">
  <div style="max-width:1400px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
    {[
      { title: 'Johnstones Certified', desc: 'Certified Johnstones Silicon Render Specialist — guaranteed quality finish.' },
      { title: 'EWI Registered', desc: 'Fully registered EWI installer. External wall insulation done to the highest standard.' },
      { title: '17 Years Experience', desc: 'Over 17 years in the plastering trade. Hundreds of satisfied customers across South Wales.' },
    ].map(c => (
      <div class="reveal" style="background:#0d1b3e;border:0.5px solid rgba(192,200,216,0.1);border-radius:1px;padding:32px 28px;">
        <div style="width:32px;height:1px;background:#c0c8d8;opacity:0.4;margin-bottom:20px;"></div>
        <h3 style="font-family:'Bebas Neue',sans-serif;font-size:22px;color:#c0c8d8;letter-spacing:0.04em;margin-bottom:10px;">{c.title}</h3>
        <p style="font-size:13px;color:rgba(255,255,255,0.4);line-height:1.7;">{c.desc}</p>
      </div>
    ))}
  </div>
</section>

<!-- REVIEWS -->
<section id="reviews" style="padding:120px 40px;border-top:0.5px solid rgba(192,200,216,0.08);background:#0d1b3e;">
  <div style="max-width:1400px;margin:0 auto;">
    <p class="reveal" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(192,200,216,0.4);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:10px;">// 04 — What clients say</p>
    <h2 class="reveal" style="font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,6vw,88px);color:#ffffff;letter-spacing:0.02em;margin-bottom:16px;line-height:0.95;">Reviews</h2>
    <div class="reveal" style="display:flex;align-items:center;gap:16px;margin-bottom:48px;">
      <div style="display:flex;gap:4px;">
        {[1,2,3,4,5].map(() => <span style="color:#c0c8d8;font-size:20px;">★</span>)}
      </div>
      <span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(192,200,216,0.5);letter-spacing:0.1em;">5.0 · 3 Reviews on Google</span>
      <a href="https://share.google/i59NPJ7tybrnHiWC1" target="_blank" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:#c0c8d8;letter-spacing:0.1em;text-decoration:none;border:0.5px solid rgba(192,200,216,0.2);padding:6px 14px;border-radius:1px;">Leave a Review →</a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
      {[
        { name: 'Rhys Morgan', text: 'Nathan has done a lot of work for me over the years, never a job too big or too small, great team! Very professional!', date: '11 months ago' },
        { name: 'Ffion Trotman', text: 'Excellent work from start to finish. Highly recommend Nathan and his team for any plastering or rendering work.', date: '11 months ago' },
        { name: 'Alicia Furber', text: 'Fantastic service, brilliant finish. Nathan and his team were professional, tidy and got the job done perfectly.', date: '11 months ago' },
      ].map(r => (
        <div class="reveal" style="background:#162552;border:0.5px solid rgba(192,200,216,0.1);border-radius:1px;padding:32px 28px;display:flex;flex-direction:column;justify-content:space-between;">
          <div>
            <div style="display:flex;gap:3px;margin-bottom:16px;">
              {[1,2,3,4,5].map(() => <span style="color:#c0c8d8;font-size:13px;">★</span>)}
            </div>
            <p style="font-size:14px;color:rgba(255,255,255,0.5);line-height:1.8;margin-bottom:20px;">"{r.text}"</p>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <p style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(192,200,216,0.4);letter-spacing:0.1em;">— {r.name}</p>
            <p style="font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(192,200,216,0.25);letter-spacing:0.08em;">{r.date}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

