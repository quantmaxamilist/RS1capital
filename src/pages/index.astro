---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import FocusedOnGrowth from '../components/FocusedOnGrowth.astro';
import NorthmarkDifference from '../components/NorthmarkDifference.astro';
import StrengthInNumbers from '../components/StrengthInNumbers.astro';
import FeaturedPortfolio from '../components/FeaturedPortfolio.astro';
import MeetTheNetwork from '../components/MeetTheNetwork.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <AnnouncementBar />
  <Nav />
  <main>
    <Hero />
    <LogoMarquee />
    <FocusedOnGrowth />
    <NorthmarkDifference />
    <StrengthInNumbers />
    <FeaturedPortfolio />
    <MeetTheNetwork />
    <Contact />
  </main>
  <Footer />
</Layout>

<script>
  import '../scripts/animations.ts';
</script>

<style is:global>
  :root {
    --announcement-height: 40px;
  }
</style>
