---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/site';

const lastUpdated = '24 November 2026';

const title = 'Privacy Policy | RS1 Capital Limited';
const description =
  'How RS1 Capital Limited uses personal information collected through this website, including enquiries and cookies.';
---

<Layout title={title} description={description}>
  <AnnouncementBar />
  <Nav onHome={false} />

  <main>
    <section class="relative bg-black pt-40 lg:pt-48 pb-16 overflow-hidden" aria-labelledby="privacy-heading">
      <div class="max-w-3xl mx-auto px-6 lg:px-10">
        <p class="eyebrow mb-5">Privacy</p>
        <h1 id="privacy-heading" class="heading-display text-[clamp(2.5rem,6vw,4.5rem)] text-mist mb-6">
          Privacy policy
        </h1>
        <p class="font-body text-sm text-mist/50">Last updated: {lastUpdated}</p>
      </div>
    </section>

    <section class="bg-black pb-24 lg:pb-32">
      <div class="max-w-3xl mx-auto px-6 lg:px-10 font-body text-base text-mist/75 leading-relaxed space-y-10">
        <div class="space-y-4">
          <h2 class="heading-display text-2xl text-mist">Who we are</h2>
          <p>RS1 Capital Limited is the data controller for personal information collected through this website.</p>
          <ul class="list-disc pl-5 space-y-2">
            <li>Email: <a href="mailto:info@rs1.uk" class="text-link">info@rs1.uk</a></li>
            <li>WhatsApp: <a href="https://wa.me/447500111500" class="text-link">07500 111500</a></li>
            <li>United Kingdom office: 160 City Road, London, EC1V 2NX</li>
            <li>Spain office: C/ San Fernando 34, 07702 Mahón, Balearic Islands</li>
          </ul>
          <p>
            {company.legalName} is registered in {company.jurisdiction}, company number {company.number}. Registered office: {company.registeredOffice}.
          </p>
        </div>

        <div class="space-y-4">
          <h2 class="heading-display text-2xl text-mist">What we collect</h2>
          <p>
            If you use the enquiry form, we collect your name, email address, company name if you give one, phone number if you give one, the nature of your enquiry, and your message.
          </p>
          <p>
            When you load a page, your browser also sends technical information such as your IP address to the host of this website. We do not use that information to identify you.
          </p>
        </div>

        <div class="space-y-4">
          <h2 class="heading-display text-2xl text-mist">Why</h2>
          <p>
            We use enquiry details to reply to you and to take steps you ask for before a contract for investment, lending or advice. The lawful bases are our legitimate interests in responding to enquiries, and steps taken at your request before entering a contract.
          </p>
        </div>

        <div class="space-y-4">
          <h2 class="heading-display text-2xl text-mist">Who we share it with</h2>
          <p>We share personal information only as far as we need to run this website and reply to you:</p>
          <ul class="list-disc pl-5 space-y-2">
            <li>Vercel, which hosts the website.</li>
            <li>Web3Forms, which receives the enquiry form and sends it to us.</li>
          </ul>
          <p>Some of these providers may process personal data outside the UK. Where they do, they do so under appropriate safeguards.</p>
          <p>The WhatsApp link leaves this website. WhatsApp has its own privacy notice.</p>
        </div>

        <div class="space-y-4">
          <h2 class="heading-display text-2xl text-mist">How long we keep it</h2>
          <p>We keep enquiry information for up to 2 years, unless you become a customer.</p>
        </div>

        <div class="space-y-4">
          <h2 class="heading-display text-2xl text-mist">Your rights</h2>
          <p>
            You can ask us for access to the personal information we hold about you, and you can ask us to correct it, delete it, or stop using it in certain cases (objection).
          </p>
          <p>
            You also have the right to complain to the Information Commissioner’s Office at <a href="https://ico.org.uk" class="text-link" target="_blank" rel="noopener">ico.org.uk</a>.
          </p>
          <p>
            To use these rights, email <a href="mailto:info@rs1.uk" class="text-link">info@rs1.uk</a> or write to RS1 Capital Limited, 160 City Road, London, EC1V 2NX.
          </p>
        </div>

        <div class="space-y-4" id="cookies">
          <h2 class="heading-display text-2xl text-mist">Cookies</h2>
          <p>This site does not use advertising or tracking cookies.</p>
          <p>
            It does not set analytics, advertising or social-media cookies. The fonts and icons on these pages are served from this website itself, not from a third party. We do not use a cookie banner because there is nothing non-essential to accept or reject.
          </p>
        </div>

        <p class="text-sm text-mist/50">Last updated: {lastUpdated}</p>
      </div>
    </section>
  </main>

  <Footer onHome={false} />
</Layout>

<script>
  import '../scripts/animations.ts';
</script>
