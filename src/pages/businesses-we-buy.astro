---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { acquisitionsIntro, acquisitionSituations } from '../data/site';

const title = 'The Businesses We Buy | RS1 Capital Limited';
const description =
  'RS1 Capital acquires businesses across the UK and Europe in time-critical, retirement and financial-distress situations — working with owners, lenders and insolvency practitioners with speed, certainty and discretion.';
---

<Layout title={title} description={description}>
  <AnnouncementBar />
  <Nav onHome={false} />

  <main>
    <!-- Intro -->
    <section class="relative bg-black pt-40 lg:pt-48 pb-20 lg:pb-24 overflow-hidden" aria-labelledby="acq-heading" data-glow-follow>
      <div class="approach-glow" aria-hidden="true"><div class="approach-glow__spot"></div></div>

      <div class="max-w-4xl mx-auto px-6 lg:px-10 relative z-[1]">
        <p class="eyebrow mb-5" data-reveal>Acquisitions</p>
        <h1
          id="acq-heading"
          class="heading-display text-[clamp(2.5rem,6vw,4.5rem)] text-mist mb-6"
          data-reveal
        >
          The Businesses We Buy
        </h1>
        <p class="font-body text-xs sm:text-sm font-semibold tracking-[0.22em] uppercase text-gold mb-8" data-reveal>
          Time-Critical · Retirement · Financial Distress
        </p>
        <p class="font-body text-lg text-mist/75 leading-relaxed max-w-2xl" data-reveal>
          {acquisitionsIntro}
        </p>
      </div>
    </section>

    <!-- The three situations -->
    <section class="bg-black pb-8 lg:pb-12" aria-label="The situations we buy into">
      <div class="max-w-4xl mx-auto px-6 lg:px-10">
        <div class="border-t border-white/10" data-reveal-group data-reveal-stagger="0.1">
          {
            acquisitionSituations.map((situation, i) => (
              <article class="grid md:grid-cols-[auto_1fr] gap-6 md:gap-10 py-12 lg:py-16 border-b border-white/10" data-reveal>
                <div class="font-display text-4xl lg:text-5xl text-gold/60 leading-none tabular-nums">
                  0{i + 1}
                </div>
                <div>
                  <h2 class="heading-display text-2xl lg:text-3xl text-mist mb-4">{situation.title}</h2>
                  <p class="font-body text-base text-mist/70 leading-relaxed max-w-2xl">{situation.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Speak to us CTA -->
    <section class="relative bg-black py-24 lg:py-28 overflow-hidden" data-glow-follow>
      <div class="contact-glow absolute bottom-0 left-0 right-0 h-2/3 pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-3xl mx-auto px-6 lg:px-10 relative z-[1] text-center">
        <h2 class="heading-display text-[clamp(2rem,4vw,3rem)] text-mist mb-5" data-reveal>
          Speak to us, in confidence
        </h2>
        <p class="font-body text-mist/70 text-base leading-relaxed mb-10 max-w-xl mx-auto" data-reveal>
          Every enquiry is treated in strict confidence, whatever stage you're at.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4" data-reveal>
          <a href="/#contact" class="btn-gold inline-flex items-center justify-center font-body text-xs font-semibold tracking-[0.14em] uppercase text-black bg-gold rounded-md px-8 py-4">
            Get in touch
          </a>
          <a href="mailto:info@rs1.uk" class="explore-link text-sm">info@rs1.uk</a>
        </div>
      </div>
    </section>
  </main>

  <Footer onHome={false} />
</Layout>

<script>
  import '../scripts/animations.ts';
</script>

<style is:global>
  :root {
    --announcement-height: 40px;
  }
</style>
