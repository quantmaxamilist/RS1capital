---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Northmark Ventures | Strategic Venture Capital & Growth Equity',
  description =
    'Northmark Ventures is a strategic venture capital and growth-equity firm backing category-defining companies across AI, robotics, deep tech, climate, data and digital infrastructure.',
} = Astro.props;

const schemaLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Northmark Ventures',
  description,
  url: 'https://northmarkventures.com',
  logo: 'https://northmarkventures.com/favicon.svg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '123 Placeholder Ave, Suite 000',
    addressLocality: 'Chicago',
    addressRegion: 'IL',
    postalCode: '60600',
    addressCountry: 'US',
  },
  sameAs: [
    'https://www.linkedin.com/company/northmark-ventures',
    'https://www.youtube.com/@northmarkventures',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Hanken+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schemaLd)} />
  </head>
  <body class="bg-black text-mist antialiased">
    <slot />
  </body>
</html>
