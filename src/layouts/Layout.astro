---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RS1 Capital Limited | Specialist Investment, Lending & Advisory',
  description =
    'RS1 Capital Limited is a specialist investment, lending and advisory firm supporting businesses across the UK and Europe — providing capital, operational turnaround and strategic advice where speed, certainty and pragmatism matter.',
} = Astro.props;

const schemaLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'RS1 Capital Limited',
  description,
  url: 'https://rs1.uk',
  email: 'info@rs1.uk',
  logo: 'https://rs1.uk/logo.png',
  address: [
    {
      '@type': 'PostalAddress',
      name: 'Spain Office',
      streetAddress: 'C/ San Fernando 34',
      addressLocality: 'Mahón',
      addressRegion: 'Balearic Islands',
      postalCode: '07702',
      addressCountry: 'ES',
    },
    {
      '@type': 'PostalAddress',
      name: 'United Kingdom Office',
      streetAddress: '160 City Road',
      addressLocality: 'London',
      postalCode: 'EC1V 2NX',
      addressCountry: 'GB',
    },
  ],
  sameAs: ['https://www.linkedin.com/company/rs1-capital'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Hanken+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schemaLd)} />
  </head>
  <body class="bg-black text-mist antialiased">
    <slot />
  </body>
</html>
